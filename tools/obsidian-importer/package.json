{
  "name": "@limiteddissolve/obsidian-importer",
  "type": "module",
  "version": "1.2.0",
  "private": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "obsidian-importer": "src/run.ts"
  },
  "files": [
    "README.md",
    "src"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "start": "bun run src/run.ts",
    "validate": "bun run src/run.ts --validate",
    "dev": "bun run --hot --watch src/run.ts",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@injurka/finance-contract": "workspace:*",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/bun": "latest",
    "@types/node": "26.5.1",
    "@types/prompts": "^2.4.9",
    "eslint": "^10.10.0",
    "eslint-plugin-format": "2.0.1",
    "typescript": "6.0.3"
  }
}
