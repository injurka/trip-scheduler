{
  "name": "@injurka/kit-image-viewer",
  "type": "module",
  "version": "1.0.0",
  "description": "Full-featured Vue 3 Image Viewer with zoom, swipe gestures, EXIF metadata and thumbnails",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@iconify/vue": "^5.0.1",
    "@vueuse/core": "^14.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/node": "26.5.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-plugin-format": "2.0.1",
    "happy-dom": "^20.14.5",
    "sass": "1.104.1",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
