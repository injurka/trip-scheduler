# =================================================================
# Этап 1: "builder" - Установка зависимостей и сборка клиента
# =================================================================
FROM oven/bun:1.4.0 AS builder

WORKDIR /usr/src/app

ARG VITE_APP_SERVER_URL
ARG VITE_APP_REQUEST_THROTTLE
ARG VITE_MAPTILER_KEY

COPY . .

RUN bun install --ignore-scripts
RUN bun --cwd=apps/client run build

# =================================================================
# Этап 2: "release" - Создание финального образа с Nginx
# =================================================================
FROM nginx:stable-alpine

COPY --from=builder /usr/src/app/apps/client/dist /usr/share/nginx/html
COPY apps/client/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# VITE_APP_SERVER_URL подставляется в собранные JS при старте контейнера
# (в сборке захардкожен плейсхолдер __VITE_APP_SERVER_URL__)
CMD ["/bin/sh", "-c", "TARGET_URL=\"${VITE_APP_SERVER_URL:-https://trip-scheduler-api.limited-dissolve.ru}\"; find /usr/share/nginx/html -type f -name '*.js' -exec sed -i -e \"s|__VITE_APP_SERVER_URL__|$TARGET_URL|g\" {} +; exec nginx -g 'daemon off;'"]
