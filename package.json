{
  "name": "@injurka/trip-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "--------------------------------<      DEV       >--------------------------------": "",
    "dev:client": "bun --filter='@injurka/trip-scheduler-client' dev",
    "dev:server": "bun run --cwd ./apps/server dev",
    "dev:native": "bun run --filter='@injurka/trip-scheduler-native' tauri:dev",
    "--------------------------------<      BUILD     >--------------------------------": "",
    "build": "bun run --filter='./apps/*' --filter='./packages/*' --filter='./tools/*' build",
    "build:web": "bun run --filter='@injurka/trip-scheduler-client' build",
    "build:client:tauri": "bun run --filter='@injurka/trip-scheduler-client' build:tauri",
    "build:native": "bun run --filter='@injurka/trip-scheduler-native' tauri:build",
    "build:native:linux:x64": "bun run --filter='@injurka/trip-scheduler-native' tauri:build:linux:x64",
    "build:native:win:x64": "bun run --filter='@injurka/trip-scheduler-native' tauri:build:win:x64",
    "build:native:android": "bun run --filter='@injurka/trip-scheduler-native' tauri:android:build",
    "--------------------------------< LINT & FORMAT >---------------------------------": "",
    "lint": "bun run --filter='./apps/*' --filter='./packages/*' --filter='./tools/*' lint",
    "lint:fix": "bun run --filter='./apps/*' --filter='./packages/*' --filter='./tools/*' lint:fix",
    "typecheck": "bun --filter='./apps/*' --filter='./packages/*' --filter='./tools/*' typecheck",
    "--------------------------------<     TESTS      >---------------------------------": "",
    "test:e2e": "bun --filter='./apps/client' test:e2e",
    "test:e2e:ui": "bun --filter='./apps/client' test:e2e:ui",
    "test:e2e:mock": "bun --filter='./apps/client' test:e2e:mock",
    "--------------------------------<     HELPERS   >---------------------------------": "",
    "import:obsidian": "bun run tools/obsidian-importer/src/run.ts",
    "skills:install": "bun run tools/skills-installer/src/run.ts",
    "postinstall": "lefthook install",
    "remove-prompt": "find . -type f -name 'src_prompt.md' -delete"
  },
  "devDependencies": {
    "lefthook": "^1.13.6"
  }
}
