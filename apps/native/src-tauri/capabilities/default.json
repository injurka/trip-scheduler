{
  "identifier": "default",
  "description": "TripScheduler native shell permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "dialog:default",
    "http:allow-fetch",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://trip-scheduler-api.limited-dissolve.ru/*"
        },
        {
          "url": "http://localhost:*/*"
        }
      ]
    },
    "deep-link:default",
    "opener:default",
    "geolocation:allow-check-permissions",
    "geolocation:allow-request-permissions",
    "geolocation:allow-get-current-position",
    "geolocation:allow-watch-position",
    "geolocation:allow-clear-watch",
    "tracking:allow-start-tracking",
    "tracking:allow-stop-tracking",
    "tracking:allow-is-tracking-running",
    "tracking:allow-get-buffered-locations",
    "tracking:allow-check-permissions",
    "tracking:allow-request-notification-permission",
    "tracking:allow-request-ignore-battery-optimizations",
    "tracking:allow-request-activity-permission",
    "tracking:allow-open-app-settings"
  ]
}
