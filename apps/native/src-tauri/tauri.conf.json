{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "trip-scheduler",
  "version": "0.1.0",
  "identifier": "ru.tripscheduler.app",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --cwd ../.. dev:client",
    "beforeBuildCommand": "bun run --cwd ../.. build:client:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "TripScheduler",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "trip-scheduler"
        ]
      }
    }
  }
}
