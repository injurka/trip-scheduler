{
  "name": "@injurka/trip-scheduler-client",
  "type": "module",
  "version": "1.0.1",
  "private": true,
  "description": "Trip Scheduler Application",
  "author": {
    "name": "Ivan Kornilov",
    "email": "injurka@gmail.com"
  },
  "homepage": "https://trip-scheduler.ru",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "--------------------------------<      DEV       >--------------------------------": "",
    "dev": "vite --config build/vite.config.web.ts",
    "dev:tauri": "vite --config build/vite.config.tauri.ts",
    "--------------------------------<      BUILD     >--------------------------------": "",
    "build": "bun run maplibre:bundle-worker && vite build --config build/vite.config.web.ts",
    "build:tauri": "bun run maplibre:bundle-worker && vite build --config build/vite.config.tauri.ts",
    "icons:bundle": "bun run build/bundle-icons.ts",
    "maplibre:bundle-worker": "bun run build/bundle-maplibre-worker.ts",
    "preview": "vite preview --config build/vite.config.web.ts",
    "--------------------------------<   STORYBOOK   >---------------------------------": "",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build -o dist-storybook",
    "--------------------------------<   DATABASE    >---------------------------------": "",
    "db:seed": "TODO",
    "db:reset": "TODO",
    "--------------------------------< LINT & FORMAT >---------------------------------": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "--------------------------------<     TESTS      >---------------------------------": "",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mock": "MOCK_API=true playwright test",
    "--------------------------------<     UTILS     >---------------------------------": "",
    "generate-pwa-assets": "pwa-assets-generator",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
