{
  "name": "@injurka/trip-scheduler-server",
  "type": "module",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "--------------------------------<      DEV       >--------------------------------": "",
    "dev": "bun run --hot --watch src/server.ts",
    "dev:debug": "bun --inspect run --hot --watch src/server.ts",
    "--------------------------------<   DATABASE    >---------------------------------": "",
    "db:migrate": "bun run db/migrate.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:dump": "bun run db/create-dump.ts",
    "db:check": "bun run db/check-data.ts",
    "db:clean": "bun run db/reset.ts",
    "db:seed-mock": "bun run db/seed-from-mock.ts",
    "db:seed-dump": "bun run db/seed-from-dump.ts",
    "db:studio": "bunx drizzle-kit studio",
    "db:reset": "bunx drizzle-kit drop",
    "--------------------------------< LINT & FORMAT >---------------------------------": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/trpc-server": "^0.4.2",
    "@injurka/finance-contract": "workspace:*",
    "@injurka/track-processing": "workspace:*",
    "@limiteddissolve/obsidian-importer": "workspace:*",
    "@trpc/server": "^11.18.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "exifr": "^7.1.3",
    "hono": "^4.13.7",
    "node-cron": "^4.6.0",
    "openai": "^7.15.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "prompts": "^2.4.2",
    "resend": "^6.28.0",
    "sharp": "^0.35.4",
    "trpc-to-openapi": "^3.3.0",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/bun": "latest",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/prompts": "^2.4.9",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-format": "2.0.1",
    "typescript": "6.0.3"
  }
}
